---
import ComicButton from '@src/components/ComicButton.svelte'
import ShareButton from '@src/components/ShareButton.svelte'
import iconArrowLeft from 'tint/icons/20-arrow-left.svg?raw'
import iconArrowRight from 'tint/icons/20-arrow-right.svg?raw'
import { comicDateFormatter, type ComicProps } from '@src/comic-data'
import OptimizedImg from './OptimizedImg.astro'

type Props = ComicProps
const { title, date, alt, panelFiles, Content, comicId, nextComic, prevComic } =
  Astro.props

const comicNumber = parseInt(comicId)
const isOldComic = comicNumber <= 41
const additionalPanels =
  isOldComic && panelFiles[1] ? [panelFiles[1]] : panelFiles.slice(1)
---

<section class="sections">
  <OptimizedImg
    src={panelFiles[0]}
    alt={alt ? alt[0] : 'Sorry, older comics do not have alt-text.'}
  />
  {
    isOldComic && panelFiles[1] ? (
      <details>
        <summary>Hidden panel?</summary>
        <OptimizedImg
          src={panelFiles[1]}
          alt={alt ? alt[1] : 'Sorry, older comics do not have alt-text.'}
        />
      </details>
    ) : null
  }
  {
    !isOldComic
      ? additionalPanels.map((file, i) => (
          <OptimizedImg
            src={file}
            alt={alt ? alt[i + 1] : 'Sorry, older comics do not have alt-text.'}
          />
        ))
      : null
  }
</section>

<div class="title-block">
  <h1 class="tint--type-title-serif-2">{title}</h1>
  <time class="tint--type-body-sans-small" datetime={date.toISOString()}>
    {comicDateFormatter.format(date)}
  </time>
</div>

<nav>
  <ComicButton
    icon
    aria-label="Previous comic"
    disabled={prevComic === undefined}
    href={`/comic/${prevComic}`}
  >
    <Fragment set:html={iconArrowLeft} />
  </ComicButton>
  <ShareButton client:idle comicId={comicId} title={title} />
  <ComicButton
    icon
    aria-label="Next comic"
    disabled={nextComic === undefined}
    href={`/comic/${nextComic}`}
  >
    <Fragment set:html={iconArrowRight} />
  </ComicButton>
</nav>

<div class="text tint--type-body-serif">
  <Content />
</div>

<style lang="sass">
  :global(body.page-comic .content)
    max-width: clamp(600px, 80vh - 2 * #{tint.$size-16}, 720px)

  .sections
    display: flex
    flex-direction: column
    align-items: center
    width: 100%
    gap: tint.$size-8
    :global(picture)
      width: max-content
      max-width: 100%
    :global(img)
      width: auto
      height: auto
      max-width: 100%
      margin: 0 auto
    details
      summary
        cursor: pointer
        padding: tint.$size-8
        background: var(--tint-bg)
        border: 1px solid var(--tint--card-border)
        border-radius: tint.$size-4
        margin-bottom: tint.$size-8
        user-select: none
        &:hover
          background: var(--tint--card-bg-hover)
      &[open] summary
        border-bottom-left-radius: 0
        border-bottom-right-radius: 0
        margin-bottom: 0

  .title-block
    text-align: center
    margin-block-start: tint.$size-24
    h1
      margin: 0
    time
      display: block
      color: var(--tint-text-secondary)
      margin-block-start: tint.$size-4

  nav
    display: flex
    justify-content: center
    align-items: center
    gap: tint.$size-8
    margin-block-start: tint.$size-16

  .text
    max-width: 512px
    margin: tint.$size-32 auto 0
    text-align: center
    :global(.hidden)
      display: inline-block
      padding: tint.$size-8
      margin-block-start: tint.$size-8
      background: var(--tint-bg)
      border: 1px solid var(--tint--card-border)
      border-radius: tint.$size-8
      opacity: 0
      transition: opacity 0.2s ease-in-out
      background: repeating-linear-gradient(45deg,#FFF8F5,#FFF8F5 10px,#FFFDFC 10px, #FFFDFC 20px)
      @media (prefers-color-scheme: dark)
        background: repeating-linear-gradient(45deg,#271614,#271614 10px,#1C1312 10px, #1C1312 20px)
      &:hover, &:focus
        opacity: 1
</style>
