---
import logo from '@src/assets/g-logo.svg?raw'
import iconInstagram from '@src/assets/socials/instagram.svg?raw'
import iconFacebook from '@src/assets/socials/facebook.svg?raw'
import iconMastodon from '@src/assets/socials/mastodon.svg?raw'
import iconBluesky from '@src/assets/socials/bluesky.svg?raw'
const currentYear = new Date().getFullYear()
---

<footer>
  <ul class="socials" aria-label="Social media">
    <li>
      <a href="//juliana.me" aria-label="Juliana Gaibler Website">
        <Fragment set:html={logo} />
      </a>
    </li>
    <li>
      <a
        href="https://instagram.com/pretendstobedrawing/"
        rel="noopener"
        target="_blank"
        aria-label="Pretends to be Drawing on Instagram"
      >
        <Fragment set:html={iconInstagram} />
      </a>
    </li>
    <li>
      <a
        href="https://facebook.com/pretendstobedrawing/"
        rel="noopener"
        target="_blank"
        aria-label="Pretends to be Drawing on Facebook"
      >
        <Fragment set:html={iconFacebook} />
      </a>
    </li>
    <li>
      <a
        href="https://mastodon.social/@JulianaGaibler"
        rel="me noopener"
        target="_blank"
        aria-label="Juliana Gaibler on Mastodon"
      >
        <Fragment set:html={iconMastodon} />
      </a>
    </li>
    <li>
      <a
        href="https://bsky.app/profile/juliana.me"
        rel="me noopener"
        target="_blank"
        aria-label="Juliana Gaibler on Bluesky"
      >
        <Fragment set:html={iconBluesky} />
      </a>
    </li>
  </ul>
  <span
    >© 2016-{currentYear} Juliana Gaibler · <a
      lang="de"
      href="//juliana.me/imprint">Impressum</a
    ></span
  >
</footer>

<style lang="sass">
  footer
    display: flex
    flex-direction: column
    align-items: center
    margin-top: tint.$size-80
    text-align: center
    padding-inline: tint.$size-16
    padding-block: tint.$size-32
    color: var(--tint-text-secondary)
    background: var(--tint-input-bg)
    --mask: linear-gradient(180deg,#0000 16px,#000 0), radial-gradient(16px,#000 calc(100% - 1px),#0000) top/29.6px 32px
    -webkit-mask: var(--mask)
    mask: var(--mask)
    a:hover, a:focus
      color: var(--tint-text-link)

  .socials
    list-style: none
    display: flex
    gap: tint.$size-4
    padding: 0
    margin: 0 0 tint.$size-8
    li
      display: flex
    a
      @include tint.effect-focus
      display: flex
      align-items: center
      justify-content: center
      width: tint.$size-40
      height: tint.$size-40
      border-radius: 9999px
      color: var(--tint-text-secondary)
      text-decoration: none
      &:hover, &:focus
        color: var(--tint-text-link)
        background: var(--tint--card-bg-hover)
    :global(svg)
      width: auto
      height: tint.$size-24
